########################################
# Application
########################################

APP_NAME=Coreflare
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

SSH_DEBUG=false

########################################
# Logging
########################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

########################################
# Database
########################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xdeploy
DB_USERNAME=root
DB_PASSWORD=

########################################
# Session
########################################

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

########################################
# Passkeys / WebAuthn
########################################

# Local defaults. Production should use the exact application domain/origin.
PASSKEYS_RELYING_PARTY_ID=localhost
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8000

# In production, set a stable random secret independent from APP_KEY.
# Once Passkeys exist, do not rotate this value casually.
# PASSKEYS_USER_HANDLE_SECRET=

########################################
# Cache
########################################

CACHE_STORE=file

########################################
# Queue
########################################

QUEUE_CONNECTION=database
DB_QUEUE_RETRY_AFTER=3000

########################################
# Broadcasting
########################################

BROADCAST_CONNECTION=log

########################################
# Filesystem
########################################

FILESYSTEM_DISK=local

########################################
# Mail
########################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

########################################
# Frontend
########################################

VITE_APP_NAME="${APP_NAME}"

########################################
# SmsIR
########################################

SMSIR_API_KEY=
SMSIR_TEMPLATE_ID=
SMSIR_PARAMETER_NAME=Code
SMSIR_EXPIRING_SOON_TEMPLATE_ID=
SMSIR_EXPIRING_SOON_PARAMETER_NAME=Hours
SMS_DRIVER=fake

########################################
# Payment Gateway
########################################

PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=
ZARINPAL_SANDBOX=true

########################################
# Server Credentials Encryption
########################################

SERVER_CREDENTIALS_CURRENT_KEY_ID=v1
SERVER_CREDENTIALS_KEY_V1=

########################################
# xDeploy SSH / Installer Delivery
########################################

XDEPLOY_SSH_ALLOW_PRIVATE_TARGETS=false

# Installer source defaults to "local" outside production and "http" in production.
# Set these only when overriding the environment-aware defaults.
# XDEPLOY_INSTALLER_SOURCE=http
# XDEPLOY_INSTALLER_BASE_URL=https://assets.example.com
# XDEPLOY_DOCKER_DEBIAN_FAMILY_SHA256=
# XDEPLOY_MARZBAN_UBUNTU_SHA256=

########################################
# Cloud Provider
########################################

CLOUD_PROVIDER=arvan

########################################
# Cloud Purchase Catalog Cache
########################################

CLOUD_CATALOG_CACHE_ENABLED=true
CLOUD_CATALOG_CACHE_LOCK_SECONDS=30

CLOUD_CATALOG_REGIONS_FRESH_SECONDS=1800
CLOUD_CATALOG_REGIONS_STALE_SECONDS=21600

CLOUD_CATALOG_SIZES_FRESH_SECONDS=600
CLOUD_CATALOG_SIZES_STALE_SECONDS=3600

CLOUD_CATALOG_IMAGES_FRESH_SECONDS=1800
CLOUD_CATALOG_IMAGES_STALE_SECONDS=21600

########################################
# Cloud Provisioning Workflow
########################################

CLOUD_PROVISIONING_MAX_ATTEMPTS=20
CLOUD_PROVISIONING_POLL_DELAY_SECONDS=3

########################################
# Cloud Resize Workflow
########################################

CLOUD_RESIZE_ENABLED=false

CLOUD_RESIZE_STOP_ATTEMPTS=30
CLOUD_RESIZE_STOP_DELAY_MS=5000

CLOUD_RESIZE_ACTIVE_ATTEMPTS=120
CLOUD_RESIZE_ACTIVE_DELAY_MS=5000

CLOUD_RESIZE_LOCK_TTL_SECONDS=1200
CLOUD_RESIZE_LOCK_WAIT_SECONDS=3

########################################
# Temporary Cloud Discovery
########################################

ARVAN_CLOUD_DISCOVERY_ENABLED=false

########################################
# ArvanCloud Connection
########################################

ARVAN_CLOUD_API_KEY=
ARVAN_CLOUD_BASE_URL=https://napi.arvancloud.ir/ecc/v1
ARVAN_CLOUD_REGION=eu-west1-a

ARVAN_CLOUD_CONNECT_TIMEOUT=10
ARVAN_CLOUD_TIMEOUT=90

########################################
# ArvanCloud Provisioning Defaults
########################################

ARVAN_CLOUD_DEFAULT_SIZE_ID=eco-1-1-0
ARVAN_CLOUD_DEFAULT_IMAGE_ID=00aaa9d1-3e0a-468c-aaf4-334513981e42
ARVAN_CLOUD_DEFAULT_NETWORK_ID=c72ea6b9-e1c1-4b72-80eb-adc6fc1941a2

ARVAN_CLOUD_DEFAULT_SECURITY_GROUP_ID=8449a4f5-5709-4017-9e63-45496bfe5cc9
ARVAN_CLOUD_DEFAULT_SECURITY_GROUP_NAME=default

ARVAN_CLOUD_DEFAULT_CREATE_TYPE=cinder
ARVAN_CLOUD_DEFAULT_USERNAME=ubuntu
ARVAN_CLOUD_DEFAULT_DISK_SIZE=25
ARVAN_CLOUD_DEFAULT_INIT_SCRIPT=
ARVAN_CLOUD_DEFAULT_HA_ENABLED=false
