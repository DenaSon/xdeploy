########################################
# Application
########################################

APP_NAME=Coreflare
APP_ENV=local
APP_KEY=
APP_DEBUG=true

APP_URL=http://localhost:8000
ASSET_URL=

APP_LOCALE=fa
APP_FALLBACK_LOCALE=en

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12


########################################
# Logging
########################################

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


########################################
# Database
########################################

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=coreflare
DB_USERNAME=root
DB_PASSWORD=


########################################
# Redis
########################################

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_USERNAME=null
REDIS_PASSWORD=null
REDIS_PORT=6379

REDIS_DB=0
REDIS_CACHE_DB=1


########################################
# Session
########################################

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null


########################################
# Cache
########################################

CACHE_STORE=file

SETTINGS_CACHE_ENABLED=true
SETTINGS_CACHE_MEMO=true


########################################
# Queue
########################################

QUEUE_CONNECTION=database

# Must remain greater than the longest provisioning job timeout.
DB_QUEUE_RETRY_AFTER=3000
REDIS_QUEUE_RETRY_AFTER=3000


########################################
# Broadcasting
########################################

BROADCAST_CONNECTION=log


########################################
# Filesystem
########################################

FILESYSTEM_DISK=local


########################################
# Mail
########################################

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=

MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"


########################################
# Frontend
########################################

VITE_APP_NAME="${APP_NAME}"


########################################
# Product Analytics / PostHog
########################################

# Keep disabled until the production project token is configured.
POSTHOG_ENABLED=false
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_QUEUE=default
POSTHOG_CONNECT_TIMEOUT=1
POSTHOG_TIMEOUT=3


########################################
# Passkeys / WebAuthn
########################################

PASSKEYS_RELYING_PARTY_ID=localhost
PASSKEYS_ALLOWED_ORIGINS=http://localhost:8000

# Production:
# - Must be stable.
# - Must be independent from APP_KEY.
# - Do not rotate after Passkeys have been registered without a migration plan.
PASSKEYS_USER_HANDLE_SECRET=

PASSKEYS_ADMIN_VERIFICATION_SECONDS=3600


########################################
# Server Credential Encryption
########################################

SERVER_CREDENTIALS_CURRENT_KEY_ID=v1

# Must use base64: prefix and decode to exactly 32 bytes.
# Example generation:
# php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
SERVER_CREDENTIALS_KEY_V1=


########################################
# SSH / Installer Delivery
########################################

SSH_DEBUG=false

# Keep false unless private-network SSH targets are explicitly required.
XDEPLOY_SSH_ALLOW_PRIVATE_TARGETS=false

# Production defaults to HTTP installer delivery.
# XDEPLOY_INSTALLER_SOURCE=http
# XDEPLOY_INSTALLER_BASE_URL=https://coreflare.example/assets/installers

# Optional integrity overrides:
# XDEPLOY_DOCKER_DEBIAN_FAMILY_SHA256=
# XDEPLOY_CADDY_DEBIAN_FAMILY_SHA256=
# XDEPLOY_MARZBAN_UBUNTU_SHA256=
# XDEPLOY_N8N_DOCKER_SHA256=
# XDEPLOY_WORDPRESS_DOCKER_SHA256=


########################################
# SMS / SmsIR
########################################

SMS_DRIVER=fake

SMSIR_API_KEY=

SMSIR_TEMPLATE_ID=
SMSIR_PARAMETER_NAME=Code

SMSIR_EXPIRING_SOON_TEMPLATE_ID=
SMSIR_EXPIRING_SOON_PARAMETER_NAME=Hours

# Never enable in production.
OTP_BROWSER_CONSOLE_DEBUG=false


########################################
# Payment Gateway
########################################

PAYMENT_GATEWAY=zarinpal

ZARINPAL_MERCHANT_ID=
ZARINPAL_ACCESS_TOKEN=

# Must be false in production.
ZARINPAL_SANDBOX=true


########################################
# Google OpenID Connect
########################################

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

GOOGLE_OAUTH_CONNECT_TIMEOUT=5
GOOGLE_OAUTH_TIMEOUT=10


########################################
# Telegram Integration
########################################

TELEGRAM_ENABLED=false

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

TELEGRAM_LINK_TTL_SECONDS=600
TELEGRAM_API_BASE_URL=https://api.telegram.org
TELEGRAM_CONNECT_TIMEOUT=5
TELEGRAM_TIMEOUT=10


########################################
# Cloudflare Integration
########################################

CLOUDFLARE_OAUTH_CLIENT_ID=
CLOUDFLARE_OAUTH_CLIENT_SECRET=

CLOUDFLARE_OAUTH_SCOPES=account-settings.read,zone.read,zone.write,dns.read,dns.write,offline_access

CLOUDFLARE_OAUTH_CONNECT_TIMEOUT=5
CLOUDFLARE_OAUTH_TIMEOUT=10

CLOUDFLARE_API_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_API_CONNECT_TIMEOUT=5
CLOUDFLARE_API_TIMEOUT=15
CLOUDFLARE_API_MAX_PAGES=20


########################################
# Cloud Provider
########################################

CLOUD_PROVIDER=arvan


########################################
# Cloud Purchase Transport
########################################

CLOUD_CATALOG_CONNECT_TIMEOUT=3
CLOUD_CATALOG_TIMEOUT=8

CLOUD_PRICING_CONNECT_TIMEOUT=3
CLOUD_PRICING_TIMEOUT=10

CLOUD_SAFE_READ_RETRY_MAX_ATTEMPTS=2
CLOUD_SAFE_READ_RETRY_DELAY_MS=250


########################################
# Cloud Provider Health
########################################

CLOUD_HEALTH_STATE_TTL_SECONDS=1800

CLOUD_HEALTH_LOCK_SECONDS=5
CLOUD_HEALTH_LOCK_WAIT_SECONDS=1

CLOUD_HEALTH_DEGRADED_AFTER_FAILURES=1
CLOUD_HEALTH_UNAVAILABLE_AFTER_FAILURES=3
CLOUD_HEALTH_RECOVERY_SUCCESSES=2

CLOUD_HEALTH_PROBE_ENABLED=true


########################################
# Cloud Catalog Cache
########################################

CLOUD_CATALOG_CACHE_ENABLED=true
CLOUD_CATALOG_CACHE_LOCK_SECONDS=30

CLOUD_CATALOG_REGIONS_FRESH_SECONDS=1800
CLOUD_CATALOG_REGIONS_STALE_SECONDS=21600

CLOUD_CATALOG_SIZES_FRESH_SECONDS=600
CLOUD_CATALOG_SIZES_STALE_SECONDS=3600

CLOUD_CATALOG_IMAGES_FRESH_SECONDS=1800
CLOUD_CATALOG_IMAGES_STALE_SECONDS=21600


########################################
# Cloud Provisioning
########################################

CLOUD_PROVISIONING_MAX_ATTEMPTS=20
CLOUD_PROVISIONING_POLL_DELAY_SECONDS=3


########################################
# Cloud Resize
########################################

CLOUD_RESIZE_ENABLED=false

CLOUD_RESIZE_STOP_ATTEMPTS=30
CLOUD_RESIZE_STOP_DELAY_MS=5000

CLOUD_RESIZE_ACTIVE_ATTEMPTS=120
CLOUD_RESIZE_ACTIVE_DELAY_MS=5000

CLOUD_RESIZE_LOCK_TTL_SECONDS=1200
CLOUD_RESIZE_LOCK_WAIT_SECONDS=3


########################################
# Temporary Cloud Discovery
########################################

# Never enable in production.
ARVAN_CLOUD_DISCOVERY_ENABLED=false


########################################
# ArvanCloud
########################################

ARVAN_CLOUD_ENABLED=true
ARVAN_CLOUD_PURCHASE_ENABLED=true

ARVAN_CLOUD_API_KEY=

ARVAN_CLOUD_BASE_URL=https://napi.arvancloud.ir/ecc/v1
ARVAN_CLOUD_REGION=eu-west1-a

ARVAN_CLOUD_CONNECT_TIMEOUT=10
ARVAN_CLOUD_TIMEOUT=90


########################################
# ArvanCloud Provisioning Defaults
########################################

ARVAN_CLOUD_DEFAULT_SIZE_ID=eco-1-1-0

ARVAN_CLOUD_DEFAULT_IMAGE_ID=00aaa9d1-3e0a-468c-aaf4-334513981e42
ARVAN_CLOUD_DEFAULT_NETWORK_ID=c72ea6b9-e1c1-4b72-80eb-adc6fc1941a2
ARVAN_CLOUD_DEFAULT_SECURITY_GROUP_ID=8449a4f5-5709-4017-9e63-45496bfe5cc9
ARVAN_CLOUD_DEFAULT_SECURITY_GROUP_NAME=default

ARVAN_CLOUD_DEFAULT_CREATE_TYPE=cinder
ARVAN_CLOUD_DEFAULT_USERNAME=ubuntu
ARVAN_CLOUD_DEFAULT_DISK_SIZE=25
ARVAN_CLOUD_DEFAULT_INIT_SCRIPT=
ARVAN_CLOUD_DEFAULT_HA_ENABLED=false


########################################
# Liara IaaS
########################################

LIARA_CLOUD_ENABLED=false
LIARA_CLOUD_PURCHASE_ENABLED=false

LIARA_CLOUD_API_TOKEN=

LIARA_CLOUD_BASE_URL=https://iaas-api.liara.ir
LIARA_CLOUD_REGION=iran

LIARA_CLOUD_CONNECT_TIMEOUT=10
LIARA_CLOUD_TIMEOUT=90


########################################
# Liara Provisioning Defaults
########################################

LIARA_CLOUD_DEFAULT_SIZE_ID=standard-base-g2
LIARA_CLOUD_DEFAULT_IMAGE_ID=ubuntu-24.04
LIARA_CLOUD_DEFAULT_USERNAME=root
LIARA_CLOUD_DEFAULT_DISK_SIZE=20
LIARA_CLOUD_DEFAULT_INIT_SCRIPT=
LIARA_CLOUD_DEFAULT_HA_ENABLED=false


########################################
# ParsPack Cloud Server
########################################

# Keep both disabled until the provider passes a real create/bootstrap/delete smoke test.
PARSPACK_CLOUD_ENABLED=false
PARSPACK_CLOUD_PURCHASE_ENABLED=false

PARSPACK_CLOUD_API_TOKEN=
PARSPACK_CLOUD_BASE_URL=https://my.parspack.com/cserver/api/public/v1
PARSPACK_CLOUD_REGION=frankfurt
PARSPACK_CLOUD_CONNECT_TIMEOUT=10
PARSPACK_CLOUD_TIMEOUT=90

# ParsPack creation can take longer than the generic cloud polling window.
PARSPACK_CLOUD_PROVISIONING_MAX_ATTEMPTS=60
PARSPACK_CLOUD_PROVISIONING_POLL_DELAY_SECONDS=3

# API tariffs are Tomans and are normalized to Coreflare IRR internally.
# Optional funding overhead is separate and defaults to zero.
PARSPACK_CLOUD_FUNDING_OVERHEAD_PERCENT=0

# Account SSH key ID attached to new VMs and the matching private key encoded
# as a single-line base64 secret. Never commit the decoded private key.
PARSPACK_CLOUD_BOOTSTRAP_SSH_KEY_ID=
PARSPACK_CLOUD_BOOTSTRAP_PRIVATE_KEY_BASE64=


########################################
# ParsPack Provisioning Defaults
########################################

PARSPACK_CLOUD_DEFAULT_SIZE_ID=deVPS2
PARSPACK_CLOUD_DEFAULT_IMAGE_ID=ubuntu24-cloudinit-qcow2
PARSPACK_CLOUD_DEFAULT_USERNAME=root
PARSPACK_CLOUD_DEFAULT_DISK_SIZE=40
PARSPACK_CLOUD_DEFAULT_INIT_SCRIPT=
PARSPACK_CLOUD_DEFAULT_HA_ENABLED=false
